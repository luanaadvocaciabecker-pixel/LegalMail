# Copie para .env (já está no .gitignore) e preencha com o valor real.
# NUNCA cole o valor real da chave em commits, PRs, ou no chat com um assistente.
#
# Chave de API do workspace Legalmail (Painel -> Configurações -> Painel da API
# -> Tokens de acesso). Cada chamada à API é paga com créditos do workspace;
# ver docs/legalmail-openapi.json para a tabela de endpoints cobrados.
LEGALMAIL_API_KEY=

# Caminho local da planilha real PRAZOS BECKER 2026.xlsx (fora deste repositório).
PRAZOS_BECKER_XLSX_PATH=

# Caminho do prazos_nums.json (lista de processos já conhecidos na aba PRAZOS).
PRAZOS_NUMS_JSON_PATH=
